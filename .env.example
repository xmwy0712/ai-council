# 密钥只放这里（.env 已 gitignore），或更安全地放进 OS keyring（M2 接入）。
# 严禁把任何密钥写进 config.toml、日志或会话文件。

# OpenAI / 任意 OpenAI 兼容端点（M2）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic（M2）
# ANTHROPIC_API_KEY=

# Google（M2）
# GOOGLE_API_KEY=

# 自定义 generic_http 端点（M2）
# CUSTOM_ENDPOINT_KEY=
